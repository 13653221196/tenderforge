# 复制本文件为 .env 后按需修改。真实环境变量优先级高于本文件。
# 所有项都可以留空，留空即使用默认值。

# ---------------- 服务 ----------------
# 监听地址：本机用 127.0.0.1，容器或对外用 0.0.0.0
BIDAGENT_HOST=127.0.0.1
# 监听端口
BIDAGENT_PORT=5210
# 数据目录（项目/账号/知识库/导出件都在这里，注意单独备份）
# BIDAGENT_DATA=/opt/bidagent/data

# ---------------- 首次启动的管理员 ----------------
# 只在账号库为空、第一次建管理员时生效；至少 8 位。留空则随机生成，
# 密码写入 data/初始管理员.txt。
# BIDAGENT_INIT_ADMIN_PASSWORD=

# ---------------- 模型（可选，界面上也能配） ----------------
# 任何 OpenAI 兼容接口都可以。界面上配置的多模型优先于这里。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# 单次输出上限（推理模型思考也占这个额度，建议 4096 以上）
# LLM_MAX_TOKENS=4096
# 请求超时，秒
# LLM_TIMEOUT=120
# 接口协议：chat（默认，/chat/completions）或 responses（Codex 系列必须用这个）
# 留空则按地址与模型名自动判断
# LLM_WIRE_API=
